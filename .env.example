# ============================================================
# MyMoviz Notify Bot - Environment Variables Example
# Copy this file to .env and fill in real values
# ============================================================

# ---------- Telegram ----------
# Get token from @BotFather
BOT_TOKEN=123456789:AAEXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=123456789,987654321

# ---------- Channels ----------
# Comma-separated list of channel usernames or IDs (e.g. @mymoviz_channel,-1001234567890)
# Bot MUST be admin in each channel with "Post Messages" permission
CHANNEL_IDS=@mymoviz_channel

# ---------- Database ----------
DATABASE_URL=sqlite+aiosqlite:///./data/mymoviz.db

# ---------- Scraping ----------
# Base URLs for both versions of the site
CLASSIC_BASE_URL=https://mymoviz.co
MODERN_BASE_URL=https://mymoviz.co/_modern/home

# HTTP client settings
REQUEST_TIMEOUT=30
REQUEST_MAX_RETRIES=3
REQUEST_BACKOFF_FACTOR=0.5
RATE_LIMIT_DELAY=1.5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ---------- MyMoviz Authentication (for download links) ----------
# Option A: Set email + password - bot will login at startup
MYMOVIZ_EMAIL=
MYMOVIZ_PASSWORD=
# Option B: Set a raw Cookie header string directly (takes precedence)
# Example: MYMOVIZ_COOKIE=session=abc123; csrftoken=xyz789
MYMOVIZ_COOKIE=

# ---------- Cache ----------
CACHE_TTL_SECONDS=1800
CACHE_MAX_SIZE=1000

# ---------- Scheduler ----------
# Interval in minutes for checking new episodes/qualities
CHECK_INTERVAL_MINUTES=10

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- Webhook (optional, for Railway/production) ----------
# Leave empty to use long polling
WEBHOOK_URL=
WEBHOOK_PORT=8443
WEBHOOK_PATH=/webhook

# ---------- Misc ----------
# Enable verbose startup
DEBUG=false
